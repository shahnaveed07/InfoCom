# APP_URL: The public URL where this application is hosted (used for QR verification & setup links)
APP_URL="http://localhost:3000"
PORT="3000"

# Runtime environment: development | test | production
NODE_ENV="development"

# Session signing secret (minimum 32 random chars required in production)
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# PostgreSQL / Cloud SQL connection variables (injected automatically in Cloud Run / AI Studio)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/infocom_ams"
# SQL_HOST="/app/cloudsql/PROJECT:REGION:INSTANCE"
# SQL_DB_NAME="cloud_sql_development_database"
# SQL_USER="app_user"
# SQL_PASSWORD="app_password"
# SQL_ADMIN_USER="admin_user"
# SQL_ADMIN_PASSWORD="admin_password"

# Optional isolated database overrides for NODE_ENV=test
# TEST_SQL_DB_NAME="infocom_ams_test"
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/infocom_ams_test"

# Development Demo Seeding (must stay false in production; configure explicit strong local passwords >=10 chars with upper/lower/digit before running npm run db:seed:demo)
ALLOW_DEMO_SEED="false"
# SEED_ADMIN_PASSWORD=""
# SEED_INSTRUCTOR_PASSWORD=""
# SEED_STUDENT_PASSWORD=""

# Background Job Worker (set ENABLE_BACKGROUND_WORKER="false" on scaled API replicas when running `npm run worker` separately)
ENABLE_BACKGROUND_WORKER="true"
# WORKER_LEASE_MS="120000"
# WORKER_POLL_INTERVAL_MS="15000"

# Private Document Object Storage (local | s3 | r2)
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./data/private-uploads"
# STORAGE_S3_ENDPOINT="https://s3.amazonaws.com"
# STORAGE_S3_REGION="ap-south-1"
# STORAGE_S3_BUCKET="igs-private-documents"
# STORAGE_S3_ACCESS_KEY_ID=""
# STORAGE_S3_SECRET_ACCESS_KEY=""

# Outbound Transactional Email (auto | http | smtp; if omitted, deliveries log safely in DeliveryLog)
# EMAIL_PROVIDER="auto"
# EMAIL_FROM="IGS — InfoCom Global Services <noreply@example.com>"
# RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"
# EMAIL_HTTP_URL=""
# EMAIL_HTTP_TOKEN=""
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="noreply@example.com"
# SMTP_PASS="REPLACE_WITH_SMTP_PASSWORD"
# SMTP_FROM="IGS — InfoCom Global Services <noreply@example.com>"

# Optional Decoupled Frontend-to-Backend API Configuration (leave VITE_API_BASE_URL empty for same-origin unified Express hosting)
# VITE_API_BASE_URL="https://api.example.com"
# Public catalog mode: auto | demo | api (default: auto)
VITE_PUBLIC_DATA_MODE="auto"
# Enable automatic local demo catalog fallback when backend/database is unavailable (true | false, default: true)
VITE_ENABLE_PUBLIC_DEMO_FALLBACK="true"

# Optional Comma-Separated Frontend Origins Allowed for Cross-Origin API Requests & CSRF Checks
# CORS_ALLOWED_ORIGINS="https://app.example.com,https://igs.example.com"
# Set CORS_CROSS_SITE_COOKIES="true" ONLY if frontend and API are hosted on different origins over HTTPS
CORS_CROSS_SITE_COOKIES="false"

# Optional Cloudflare Wrangler local dev Hyperdrive connection override
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://postgres:postgres@localhost:5432/infocom_ams"
