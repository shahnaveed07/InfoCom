# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Runtime environment: development | test | production
NODE_ENV="development"

# Session signing secret (minimum 32 random chars recommended for production)
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# Cloud SQL PostgreSQL connection variables (injected automatically in Cloud Run / AI Studio)
# SQL_HOST="/app/cloudsql/PROJECT:REGION:INSTANCE"
# SQL_DB_NAME="cloud_sql_development_database"
# SQL_USER="app_user"
# SQL_PASSWORD="app_password"
# SQL_ADMIN_USER="admin_user"
# SQL_ADMIN_PASSWORD="admin_password"

# Optional isolated database overrides for NODE_ENV=test
# TEST_SQL_DB_NAME="infocom_ams_test"
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/infocom_ams_test"
