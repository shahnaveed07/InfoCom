{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "igs-infocom-ams-worker",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "vars": {
    "NODE_ENV": "production",
    "APP_URL": "https://igs-infocom.pages.dev",
    "STORAGE_PROVIDER": "r2",
    "EMAIL_PROVIDER": "http",
    "CORS_ALLOWED_ORIGINS": "https://igs-infocom.pages.dev",
    "CORS_CROSS_SITE_COOKIES": "false",
    "LOG_OPERATIONAL_METRICS": "false"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_CONFIG_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS_BUCKET",
      "bucket_name": "igs-private-documents"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS_QUEUE",
        "queue": "igs-ams-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "igs-ams-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "igs-ams-jobs-dlq"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
