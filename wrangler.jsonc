{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "igs-infocom-ams-worker",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "NODE_ENV": "production",
    "APP_URL": "https://igs-infocom-ams-worker.<your-subdomain>.workers.dev",
    "STORAGE_PROVIDER": "r2",
    "EMAIL_PROVIDER": "disabled",
    "CORS_ALLOWED_ORIGINS": "https://igs-infocom-ams-worker.<your-subdomain>.workers.dev",
    "CORS_CROSS_SITE_COOKIES": "false",
    "LOG_OPERATIONAL_METRICS": "false"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "igs-infocom-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS_BUCKET",
      "bucket_name": "igs-private-documents"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS_QUEUE",
        "queue": "igs-ams-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "igs-ams-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "igs-ams-jobs-dlq"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
