{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist-server/server.js",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "cf:types": "wrangler types --strict-vars=false",
    "cf:build": "wrangler deploy --dry-run --outdir dist-worker",
    "cf:dev": "wrangler dev",
    "cf:d1:migrate:local": "wrangler d1 migrations apply igs-infocom-db --local",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply igs-infocom-db --remote",
    "cf:seed:demo:local": "tsx scripts/d1-seed-demo.ts",
    "cf:admin:bootstrap": "tsx scripts/d1-bootstrap-passkey-admin.ts",
    "cf:verify:cpu": "tsx scripts/cf-verify-hosted-cpu.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server dist-worker",
    "lint": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "tsx --test --test-concurrency=1 src/shared/academic.test.ts src/shared/validation.test.ts src/utils/public-data.test.ts server/auth.test.ts server/auth.benchmark.test.ts server/webauthn/core.test.ts server/jobs/worker.retry.test.ts server/pdf/pdf.test.ts server/db/config.test.ts server/db/prisma.test.ts server/storage/r2.test.ts server/jobs/cloudflare-queue.test.ts server/middleware/rate-limit.test.ts server/worker.test.ts server/security.integration.test.ts server/phase4.integration.test.ts server/phase5.integration.test.ts server/phase6.integration.test.ts server/phase7.integration.test.ts server/public-and-phase7.integration.test.ts server/stabilization.integration.test.ts",
    "test:unit": "tsx --test --test-concurrency=1 src/shared/academic.test.ts src/shared/validation.test.ts src/utils/public-data.test.ts server/auth.test.ts server/auth.benchmark.test.ts server/webauthn/core.test.ts server/jobs/worker.retry.test.ts server/pdf/pdf.test.ts server/db/config.test.ts server/storage/r2.test.ts server/jobs/cloudflare-queue.test.ts server/middleware/rate-limit.test.ts",
    "test:cloudflare": "tsx --test --test-concurrency=1 server/worker.test.ts server/cloudflare-d1.worker.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:worker": "playwright test --config=playwright.worker.config.ts",
    "worker": "tsx scripts/worker.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "db:generate": "tsx scripts/prisma-run.ts generate",
    "db:migrate:deploy": "tsx scripts/prisma-run.ts migrate deploy",
    "db:migrate:status": "tsx scripts/prisma-run.ts migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:migrate-json": "tsx scripts/migrate-json.ts",
    "db:migrate-documents": "tsx scripts/migrate-legacy-documents.ts",
    "email:verify": "tsx scripts/verify-email.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/adapter-pg": "^6.16.2",
    "@prisma/client": "^6.16.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "argon2": "^0.45.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.5.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "prisma": "^6.16.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "hash-wasm": "^4.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.163.0"
  }
}
